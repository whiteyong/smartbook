{
  "entities": {
    "ImageItem": {
      "title": "ImageItem",
      "description": "An image item stored in the database with metadata and hotlink configurations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique image ID"
        },
        "title": {
          "type": "string",
          "description": "Title or display name of the image",
          "maxLength": 120
        },
        "alt": {
          "type": "string",
          "description": "Alternative text for HTML hotlinking",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "description": "Direct image hotlink URL or data URI",
          "maxLength": 500000
        },
        "fileName": {
          "type": "string",
          "description": "Original file name",
          "maxLength": 150
        },
        "fileSize": {
          "type": "number",
          "description": "Size in bytes"
        },
        "mimeType": {
          "type": "string",
          "description": "Image MIME type",
          "maxLength": 50
        },
        "width": {
          "type": "number",
          "description": "Image width in pixels"
        },
        "height": {
          "type": "number",
          "description": "Image height in pixels"
        },
        "category": {
          "type": "string",
          "description": "Category or tag",
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "description": "Detailed description or notes",
          "maxLength": 500
        },
        "copyCount": {
          "type": "number",
          "description": "Number of times HTML hotlink was copied"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp in ISO format"
        }
      },
      "required": ["title", "url", "fileName", "createdAt"]
    }
  },
  "firestore": {
    "/images/{imageId}": {
      "schema": "ImageItem",
      "description": "Collection of hosted images and their hotlink metadata"
    }
  }
}
